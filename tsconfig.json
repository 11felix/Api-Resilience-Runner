{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "demo/**/*.ts", "test/**/*.ts", "bench/**/*.ts"]
}
